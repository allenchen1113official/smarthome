# 青鳥 BlueMagpie — 環境變數（install.sh 會複製成 .env；之後由後台「套用」維護）
TZ=Asia/Taipei
ADMIN_PORT=9000
ADMIN_PASSWORD=bluemagpie          # 第一次登入後台後請立刻改
HA_VERSION=stable
HA_PORT=8123
MQTT_PORT=1883
Z2M_PORT=8099
WHISPER_PORT=10300
WHISPER_MODEL=small
WHISPER_LANG=zh
PIPER_PORT=10200
PIPER_VOICE=zh_CN-huayan-medium
OLLAMA_PORT=11434
HERMES_PORT=8800
BOT_PORT=8900
HA_TOKEN=                          # 在 HA 建立長效權杖後，於後台「Home Assistant」頁填入
GROK_API_KEY=                      # 選配：xAI Grok 雲端 LLM（後台「語音」頁填入）
# 啟動的 profile：primary（主節點全套）/ standby（副節點只跑 admin+mqtt）/ ollama（容器版 Ollama）
COMPOSE_PROFILES=primary,ollama
